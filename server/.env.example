NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/task-manager
# Atlas: mongodb+srv://<user>:<password>@<cluster>/task-manager
MONGODB_URI=mongodb://127.0.0.1:27017/task-manager

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=WRITE_JWT_SECRET_TOKEN
JWT_EXPIRES_IN=1d
SALT_ROUNDS=10

# Frontend origin allowed by the CSRF origin check
CLIENT_URL=http://localhost:5173
